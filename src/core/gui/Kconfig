menuconfig LAMINPIE_GUI_ENABLE_ANIM_PLAYER
    bool "Animation Player"
    default y

if LAMINPIE_GUI_ENABLE_ANIM_PLAYER
    config LAMINPIE_GUI_ANIM_PLAYER_ENABLE_DEBUG_LOG
        bool "Enable debug log output"
        default y
endif # LAMINPIE_GUI_ENABLE_ANIM_PLAYER

menu "LVGL"
    menuconfig LAMINPIE_GUI_LVGL_ENABLE_DEBUG_LOG
        bool "Enable debug log output"
        depends on LAMINPIE_LOG_LEVEL_DEBUG

    if LAMINPIE_GUI_LVGL_ENABLE_DEBUG_LOG
        config LAMINPIE_LVGL_ANIMATION_ENABLE_DEBUG_LOG
            bool "Animation"
            depends on LAMINPIE_LOG_LEVEL_DEBUG
            default y
        
        config LAMINPIE_LVGL_CANVAS_ENABLE_DEBUG_LOG
            bool "Canvas"
            depends on LAMINPIE_LOG_LEVEL_DEBUG
            default y
        
        config LAMINPIE_LVGL_CONTAINER_ENABLE_DEBUG_LOG
            bool "Container"
            depends on LAMINPIE_LOG_LEVEL_DEBUG
            default y
        
        config LAMINPIE_LVGL_DISPLAY_ENABLE_DEBUG_LOG
            bool "Display"
            depends on LAMINPIE_LOG_LEVEL_DEBUG
            default y
        
        config LAMINPIE_LVGL_HELPER_ENABLE_DEBUG_LOG
            bool "Helper"
            depends on LAMINPIE_LOG_LEVEL_DEBUG
            default y

        config LAMINPIE_LVGL_OBJECT_ENABLE_DEBUG_LOG
            bool "Object"
            depends on LAMINPIE_LOG_LEVEL_DEBUG
            default y

        config LAMINPIE_LVGL_SCREEN_ENABLE_DEBUG_LOG
            bool "Screen"
            depends on LAMINPIE_LOG_LEVEL_DEBUG
            default y

        config LAMINPIE_LVGL_TIMER_ENABLE_DEBUG_LOG
            bool "Timer"
            depends on LAMINPIE_LOG_LEVEL_DEBUG
            default y
    endif
endmenu # LVGL

menuconfig LAMINPIE_GUI_ENABLE_SQUARELINE
    bool "Squareline Helpers"
    default y

if LAMINPIE_GUI_ENABLE_SQUARELINE
    config LAMINPIE_SQUARELINE_ENABLE_UI_COMP
        bool "Use UI component from inside"
        default y

    config LAMINPIE_SQUARELINE_ENABLE_UI_HELPERS
        bool "Use UI helpers from inside"
        default y
endif

menu "Style"
    config LAMINPIE_STYLE_ENABLE_DEBUG_LOG
        bool "Enable debug log output"
        depends on LAMINPIE_LOG_LEVEL_DEBUG
        default y
endmenu
